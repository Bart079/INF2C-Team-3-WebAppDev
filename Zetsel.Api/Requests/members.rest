@baseUrl = http://localhost:5172

### Get all members
GET {{baseUrl}}/api/members

### Get one member
GET {{baseUrl}}/api/members/1

### Create a member
POST {{baseUrl}}/api/members
Content-Type: application/json

{
  "userName": "John Doe",
  "isCommittee": false
}

### Delete a member
DELETE {{baseUrl}}/api/members/4

### Update a member
PUT {{baseUrl}}/api/members/1
Content-Type: application/json

{
    "userName": "Jane Doe",
    "isCommittee": true
}

